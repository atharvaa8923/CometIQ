# ── CometIQ configuration ─────────────────────────────────────────────
ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_EXPIRE_HOURS=24

# Database: PostgreSQL in development and production. ./run.sh starts it with Docker (docker compose service "db")
# and falls back to SQLite only when Docker is missing or with ./run.sh --sqlite. Set DATABASE_URL to use another server.
# DATABASE_URL=postgresql+psycopg://cometiq:cometiq@localhost:5432/cometiq
# Pool and timeouts (PostgreSQL)
# DB_POOL_SIZE=8          # per worker process; workers × (pool + overflow) < PostgreSQL max_connections
# DB_MAX_OVERFLOW=12
# WEB_CONCURRENCY=2       # uvicorn worker processes (about one per CPU core)
# DB_STATEMENT_TIMEOUT_MS=15000
# DB_LOCK_TIMEOUT_MS=5000
# Data retention in days (0 = keep forever); runs daily
# RETENTION_TASKS_DAYS=30
# RETENTION_NOTIFICATIONS_DAYS=180
# RETENTION_AUDIT_DAYS=0
# RETENTION_CLOSED_JOBS_DAYS=365
CORS_ORIGINS=http://localhost:5173

# Public URL (email links) and email delivery: log (dev) | resend | smtp
APP_URL=http://localhost:8000
EMAIL_PROVIDER=log
EMAIL_FROM=CometIQ <no-reply@cometiq.app>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Monitoring (optional)
SENTRY_DSN=
LOG_FORMAT=text

# Background jobs and Claude cost control
TASK_WORKERS=2
AI_DAILY_LIMIT_PER_ORG=500

# Claude AI (optional). Without a key CometIQ uses its built-in engine.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# UTD Nebula Labs (optional) — live sections & grade distributions
NEBULA_API_KEY=

# Live job postings (optional; GitHub new-grad/internship lists are always on)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_API_KEY=
USAJOBS_EMAIL=
JOB_SYNC_ENABLED=true
JOB_SYNC_HOUR_UTC=7
JOB_SYNC_LOCATION=Dallas
JOB_EXPIRE_DAYS=60

# First start
#  true  → demo institution, demo users (PUBLIC password below) and sample jobs. Demos only!
#  false → institution + catalog only; the first admin is created from BOOTSTRAP_ADMIN_*.
SEED_DEMO=true
# Faculty-only pilot: only these roles can register or sign in (empty = all roles)
PILOT_ROLES=
DEMO_PASSWORD=CometIQ2026!
ORG_NAME=The University of Texas at Dallas
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Per-user rate limits on expensive endpoints (AI, simulator, rankings, exports): 429 with Retry-After when exceeded
# RATE_LIMITS_ENABLED=true
# RATE_LIMIT_MULTIPLIER=1.0     # scale every limit, e.g. 3 for a busy pilot
# RETENTION_IDEMPOTENCY_HOURS=24
