# ── CometIQ configuration ─────────────────────────────────────────────
ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_EXPIRE_HOURS=24

# Database: SQLite by default; PostgreSQL in production
# DATABASE_URL=postgresql+psycopg://cometiq:cometiq@localhost:5432/cometiq
CORS_ORIGINS=http://localhost:5173

# Claude AI (optional). Without a key CometIQ uses its built-in engine.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# UTD Nebula Labs (optional) — live sections & grade distributions
NEBULA_API_KEY=

# Live job postings (optional; GitHub new-grad/internship lists are always on)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_API_KEY=
USAJOBS_EMAIL=
JOB_SYNC_ENABLED=true
JOB_SYNC_HOUR_UTC=7
JOB_SYNC_LOCATION=Dallas
JOB_EXPIRE_DAYS=60

# First start
#  true  → demo institution, demo users (PUBLIC password below) and sample jobs. Demos only!
#  false → institution + catalog only; the first admin is created from BOOTSTRAP_ADMIN_*.
SEED_DEMO=true
DEMO_PASSWORD=CometIQ2026!
ORG_NAME=The University of Texas at Dallas
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
